# Copy to config.env (ignored by git) and set local paths. Shell runners read config.env automatically;
# for Python scripts run directly:  set -a; . ./config.env; set +a
# --- main analysis (analysis/run_all.sh, figdata/make_figdata.py)
EXPORT_DIR=/path/to/panel_export          # communities/posts/snapshots/community_snapshots/media.parquet, manifest.json
VIDEO_VIEWS=/path/to/video_views.csv      # optional: views of the main video of clips (vk_owner_id, vk_post_id, ...)
TECH_GAP=                                 # optional: CSV of posts affected by the collection gap (vk_owner_id, vk_post_id)
ANALYSIS_OUT=/path/to/analysis_out        # results of the main analysis (pools.parquet, CSV tables, key_numbers.txt)
COMMUNITY_ID=                             # optional: internal VK id of one community to profile (33_community_profile.py)
PYTHON=python3
# --- media pipeline (media_features/)
MEDIA_ROOT=/path/to/media_work            # working dir: data/, out/, logs/
MEDIA_CUT=/path/to/media_files            # downloaded images / videos of the media slice
MEDIA_QUEUE=/path/to/media_queue.csv      # media queue of the panel
VALIDATION_DIR=/path/to/validation        # validation/ and validation2/ with blinded expert labels
PYTHON_MEDIA=python3
# --- figures (figures/)
# FIGDATA_DIR=./data
# FIG_OUT=./figures/out
